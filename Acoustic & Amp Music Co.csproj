<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MusicStorePos</RootNamespace>
    <AssemblyName>MusicStorePos</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runtime compilation helps during development; only included for Debug -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="8.0.0" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

</Project>
